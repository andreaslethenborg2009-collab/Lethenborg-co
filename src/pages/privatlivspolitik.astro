---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import { site } from "../data/site.js";

const { name, legalName, cvr, phone, email } = site.business;
---

<BaseLayout
	title="Privatlivspolitik"
	description={`Privatlivspolitik for ${name} — sådan behandler vi dine persondata.`}
>
	<Header />

	<main class="mx-auto max-w-3xl px-6 py-20 md:py-28">
		<h1 class="font-heading text-4xl font-normal text-navy">Privatlivspolitik</h1>
		<p class="mt-3 text-sm font-light text-navy/50">Sidst opdateret: august 2026</p>

		<div class="prose mt-10 max-w-none space-y-8 font-light text-navy/70">
			<section>
				<h2 class="font-heading text-xl font-normal text-navy">1. Dataansvarlig</h2>
				<p class="mt-2">
					{name} (drives af {legalName}, CVR {cvr}) er dataansvarlig for behandlingen af de
					personoplysninger, vi indsamler om dig. Har du spørgsmål til vores behandling af dine
					oplysninger, kan du kontakte os på <a href={`mailto:${email}`} class="link-underline text-gold">{email}</a> eller
					{phone}.
				</p>
			</section>

			<section>
				<h2 class="font-heading text-xl font-normal text-navy">2. Hvilke oplysninger indsamler vi</h2>
				<p class="mt-2">
					Når du udfylder vores spørgeskema om dit hjemmesideprojekt, indsamler vi de oplysninger,
					du selv afgiver — typisk navn, e-mailadresse, telefonnummer og dine svar om din
					virksomhed og ønsker til hjemmesiden.
				</p>
			</section>

			<section>
				<h2 class="font-heading text-xl font-normal text-navy">3. Formål og retsgrundlag</h2>
				<p class="mt-2">
					Vi bruger oplysningerne til at udarbejde et forslag og en pris til dig samt til
					almindelig kundeadministration. Behandlingen sker på baggrund af
					databeskyttelses­forordningens artikel 6, stk. 1, litra b (forberedelse af aftale) og
					litra f (legitim interesse i at kunne besvare henvendelser).
				</p>
			</section>

			<section>
				<h2 class="font-heading text-xl font-normal text-navy">4. Opbevaring</h2>
				<p class="mt-2">
					Vi opbevarer dine oplysninger, så længe det er nødvendigt til de formål, de er indsamlet
					til, og herefter i overensstemmelse med gældende bogføringslovgivning, hvis
					oplysningerne indgår i et regnskabsbilag.
				</p>
			</section>

			<section>
				<h2 class="font-heading text-xl font-normal text-navy">5. Videregivelse af oplysninger</h2>
				<p class="mt-2">
					Vi videregiver ikke dine oplysninger til tredjeparter, medmindre det er nødvendigt for
					at kunne levere vores ydelser (f.eks. til vores databehandler, der driver
					spørgeskemaet på hjemmesiden), eller vi er retligt forpligtet til det.
				</p>
			</section>

			<section>
				<h2 class="font-heading text-xl font-normal text-navy">6. Cookies</h2>
				<p class="mt-2">
					Vores hjemmeside bruger et minimum af cookies, primært til at huske, at du har
					accepteret vores cookiebanner. Vi bruger ikke cookies til sporing eller markedsføring
					uden dit samtykke.
				</p>
			</section>

			<section>
				<h2 class="font-heading text-xl font-normal text-navy">7. Dine rettigheder</h2>
				<p class="mt-2">
					Du har efter databeskyttelsesforordningen en række rettigheder i forhold til vores
					behandling af dine oplysninger, herunder ret til indsigt, berigtigelse, sletning,
					begrænsning og indsigelse. Ønsker du at gøre brug af dine rettigheder, kan du kontakte
					os på ovenstående kontaktoplysninger. Du kan også klage til Datatilsynet, hvis du er
					utilfreds med vores behandling af dine personoplysninger.
				</p>
			</section>

			<section>
				<h2 class="font-heading text-xl font-normal text-navy">8. Kontakt</h2>
				<p class="mt-2">
					Har du spørgsmål til denne privatlivspolitik, er du altid velkommen til at kontakte os
					på <a href={`mailto:${email}`} class="link-underline text-gold">{email}</a>.
				</p>
			</section>
		</div>
	</main>

	<Footer />
	<CookieBanner />
</BaseLayout>
