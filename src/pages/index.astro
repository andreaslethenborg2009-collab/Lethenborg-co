---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import WhatYouGet from "../components/WhatYouGet.astro";
import Process from "../components/Process.astro";
import About from "../components/About.astro";
import Work from "../components/Work.astro";
import Faq from "../components/Faq.astro";
import OnboardingQuiz from "../components/OnboardingQuiz.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
---

<BaseLayout
	title="Hjemmeside til din virksomhed i Ry og Østjylland"
	description="Få en skræddersyet, hurtig hjemmeside til din lokale virksomhed i Ry, Skanderborg og Østjylland. Se eksempler, læs hvordan det foregår, og få et konkret forslag."
>
	<Header />
	<main>
		<Hero />
		<WhatYouGet />
		<Work />
		<About />
		<Process />
		<Faq />
		<OnboardingQuiz />
	</main>
	<Footer />
	<CookieBanner />
</BaseLayout>
