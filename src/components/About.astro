---
import { site } from "../data/site.js";
---

<section id="om" class="bg-warm py-30 md:py-40">
	<div class="mx-auto max-w-6xl px-6">
		<div class="grid gap-12 md:grid-cols-12 md:gap-16">
			<div class="reveal md:col-span-5">
				<!-- Erstat med rigtigt foto af Andreas i sit miljø, når det er klar: <Image src={portrait} alt="..." class="aspect-[4/5] w-full rounded-lg object-cover" /> -->
				<div class="relative aspect-[4/5] w-full overflow-hidden rounded-lg bg-navy">
					<div
						class="absolute inset-0"
						style="background: radial-gradient(circle at 30% 20%, rgba(201,162,39,0.18), transparent 55%), radial-gradient(circle at 80% 90%, rgba(61,90,128,0.35), transparent 60%);"
					>
					</div>
					<span class="absolute bottom-8 left-8 font-heading text-6xl font-normal text-gold/25">L</span>
				</div>
			</div>

			<div class="md:col-span-7">
				<p class="reveal font-body text-xs font-normal uppercase tracking-[0.2em] text-gold">Om</p>
				<h2 class="reveal mt-4 font-heading text-3xl font-normal text-navy md:text-4xl" style="transition-delay: 100ms;">
					{site.about.heading}
				</h2>
				{site.about.paragraphs.map((paragraph, i) => (
					<p
						class="reveal mt-6 max-w-[62ch] text-base font-light leading-relaxed text-navy/70"
						style={`transition-delay: ${150 + i * 100}ms`}
					>
						{paragraph}
					</p>
				))}
				<a
					href="#kom-i-gang"
					class="btn-arrow reveal group mt-8 inline-flex items-center gap-2 font-normal text-navy transition-colors hover:text-gold"
					style="transition-delay: 450ms;"
				>
					<span class="link-underline">Lad os tage en snak</span>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
						<path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
					</svg>
				</a>
			</div>
		</div>
	</div>
</section>
