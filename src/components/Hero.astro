---
import { site } from "../data/site.js";
---

<section class="bg-primary">
	<div class="mx-auto max-w-4xl px-6 py-24 text-center md:py-32">
		<h1 class="font-heading text-4xl font-extrabold leading-tight text-white md:text-5xl">
			{site.business.tagline}
		</h1>
		<p class="mx-auto mt-6 max-w-xl text-lg text-stone-300">
			Ingen skabeloner, ingen mellemled. Fortæl mig om din virksomhed, og få et konkret forslag —
			ikke et gæt.
		</p>
		<div class="mt-10">
			<a
				href="#kom-i-gang"
				class="inline-block rounded-full bg-accent px-8 py-3.5 font-semibold text-primary shadow-lg transition-colors hover:bg-accent/90"
			>
				Kom i gang
			</a>
		</div>
	</div>
</section>
