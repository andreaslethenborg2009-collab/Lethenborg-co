---
import { site } from "../data/site.js";
---

<section class="relative flex min-h-screen items-center bg-navy">
	<div class="relative mx-auto grid w-full max-w-6xl gap-12 px-6 py-32 md:grid-cols-12 md:items-center">
		<div class="md:col-span-7">
			<p class="reveal font-body text-xs font-normal uppercase tracking-[0.2em] text-gold">
				Webbureau &middot; {site.business.area}
			</p>
			<h1
				class="reveal mt-6 font-heading text-5xl font-normal leading-[1.1] text-warm md:text-6xl lg:text-7xl"
				style="transition-delay: 150ms;"
			>
				{site.business.tagline}
			</h1>
			<p
				class="reveal mt-6 max-w-[34ch] text-base font-light leading-relaxed text-mist md:text-lg"
				style="transition-delay: 300ms;"
			>
				Ingen skabeloner, ingen mellemled. Fortæl mig om din virksomhed, og få et konkret forslag —
				ikke et gæt.
			</p>
			<div class="reveal mt-10" style="transition-delay: 450ms;">
				<a
					href="#kom-i-gang"
					class="btn-arrow group inline-flex items-center gap-2 rounded-full border border-gold px-8 py-3.5 font-normal text-gold transition-colors duration-200 hover:bg-gold hover:text-navy"
				>
					Kom i gang
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
						<path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
					</svg>
				</a>
			</div>
		</div>

		<div class="hidden md:col-span-5 md:flex md:items-center md:justify-center" aria-hidden="true">
			<svg viewBox="0 0 400 400" class="reveal h-auto w-full max-w-sm" style="transition-delay: 250ms;">
				<circle cx="200" cy="200" r="160" fill="none" stroke="#C9A227" stroke-width="0.75" opacity="0.35" />
				<circle cx="200" cy="200" r="115" fill="none" stroke="#3D5A80" stroke-width="0.75" opacity="0.5" />
				<circle cx="200" cy="200" r="70" fill="none" stroke="#C9A227" stroke-width="1" opacity="0.6" />
				<line x1="200" y1="20" x2="200" y2="90" stroke="#C9A227" stroke-width="0.75" opacity="0.5" />
				<line x1="200" y1="310" x2="200" y2="380" stroke="#3D5A80" stroke-width="0.75" opacity="0.5" />
				<line x1="20" y1="200" x2="90" y2="200" stroke="#3D5A80" stroke-width="0.75" opacity="0.5" />
				<line x1="310" y1="200" x2="380" y2="200" stroke="#C9A227" stroke-width="0.75" opacity="0.5" />
				<circle cx="200" cy="200" r="3" fill="#C9A227" />
			</svg>
		</div>
	</div>
</section>
