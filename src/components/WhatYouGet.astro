---
import { site } from "../data/site.js";
---

<section id="hvad-du-faar" class="bg-warm py-30 md:py-40">
	<div class="mx-auto max-w-6xl px-6">
		<div class="grid gap-8 md:grid-cols-12">
			<div class="md:col-span-7">
				<h2 class="reveal font-heading text-3xl font-normal text-navy md:text-4xl">
					Det, der rent faktisk gør en forskel
				</h2>
				<p class="reveal mt-4 max-w-[48ch] text-base font-light leading-relaxed text-navy/70" style="transition-delay: 100ms;">
					Ingen pakkeliste med ti ydelser — kun det, der rent faktisk gør en forskel.
				</p>
			</div>
		</div>

		<div class="mt-16 border-t border-navy/10">
			{site.whatYouGet.map((item, i) => (
				<div
					class="reveal grid gap-4 border-b border-navy/10 py-10 md:grid-cols-12 md:items-baseline md:gap-8"
					style={`transition-delay: ${i * 100}ms`}
				>
					<div class="md:col-span-2">
						<span class="font-heading text-3xl font-normal text-gold">{String(i + 1).padStart(2, "0")}</span>
					</div>
					<h3 class="font-heading text-xl font-normal text-navy md:col-span-4">{item.title}</h3>
					<p class="text-base font-light leading-relaxed text-navy/70 md:col-span-6">{item.description}</p>
				</div>
			))}
		</div>
	</div>
</section>
