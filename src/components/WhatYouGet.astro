---
import { site } from "../data/site.js";
---

<section id="hvad-du-faar" class="bg-white py-20 md:py-28">
	<div class="mx-auto max-w-6xl px-6">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="font-heading text-3xl font-bold text-primary md:text-4xl">Hvad du får</h2>
			<p class="mt-4 text-stone-600">Ingen pakkeliste med ti ydelser — kun det, der rent faktisk gør en forskel.</p>
		</div>

		<div class="mt-14 grid gap-8 sm:grid-cols-2">
			{site.whatYouGet.map((item) => (
				<div class="rounded-2xl border border-stone-100 bg-stone-50 p-8">
					<h3 class="font-heading text-lg font-semibold text-primary">{item.title}</h3>
					<p class="mt-3 text-stone-600">{item.description}</p>
				</div>
			))}
		</div>
	</div>
</section>
