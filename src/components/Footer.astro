---
import { site } from "../data/site.js";

const year = new Date().getFullYear();
---

<footer class="border-t border-gold/10 bg-navy">
	<div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 sm:grid-cols-2">
		<div>
			<p class="font-heading text-lg font-normal text-warm">{site.business.name}</p>
			<p class="mt-3 text-sm font-light text-mist">{site.business.area}</p>
			<div class="mt-3 flex flex-col text-sm font-light text-mist">
				<a href={`tel:${site.business.phone.replace(/\s/g, "")}`} class="link-underline w-fit py-1 hover:text-gold">{site.business.phone}</a>
				<a href={`mailto:${site.business.email}`} class="link-underline w-fit py-1 hover:text-gold">{site.business.email}</a>
			</div>
		</div>

		<div>
			<p class="font-heading font-normal text-warm">Info</p>
			<div class="mt-3 flex flex-col gap-2 text-sm font-light text-mist">
				<a href="/privatlivspolitik" class="link-underline w-fit hover:text-gold">Privatlivspolitik</a>
			</div>
		</div>
	</div>

	<div class="border-t border-gold/10 px-6 py-6 text-center text-xs font-light text-mist">
		&copy; {year} {site.business.name}. {site.business.name} drives af {site.business.legalName}, CVR {site.business.cvr}.
	</div>
</footer>
