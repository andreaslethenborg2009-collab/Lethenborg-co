---
import { site } from "../data/site.js";

const navLinks = [
	{ href: "#hvad-du-faar", label: "Ydelser" },
	{ href: "#saadan-arbejder-jeg", label: "Sådan arbejder jeg" },
	{ href: "#om", label: "Om" },
];
---

<header class="sticky top-0 z-50 bg-primary/95 backdrop-blur">
	<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
		<a href="#" class="font-heading text-xl font-bold text-white">
			{site.business.name}
		</a>

		<nav class="hidden md:block">
			<ul class="flex items-center gap-8 text-sm font-medium text-stone-200">
				{navLinks.map((link) => (
					<li>
						<a href={link.href} class="transition-colors hover:text-accent">{link.label}</a>
					</li>
				))}
				<li>
					<a
						href="#kom-i-gang"
						class="rounded-full bg-accent px-5 py-2 font-semibold text-primary transition-colors hover:bg-accent/90"
					>
						Kom i gang
					</a>
				</li>
			</ul>
		</nav>

		<button
			id="menu-toggle"
			type="button"
			aria-label="Åbn menu"
			aria-expanded="false"
			class="flex h-10 w-10 flex-col items-center justify-center gap-1.5 md:hidden"
		>
			<span class="h-0.5 w-6 bg-white transition-transform"></span>
			<span class="h-0.5 w-6 bg-white transition-opacity"></span>
			<span class="h-0.5 w-6 bg-white transition-transform"></span>
		</button>
	</div>

	<nav id="mobile-menu" class="hidden border-t border-white/10 md:hidden">
		<ul class="flex flex-col gap-1 px-6 py-4 text-sm font-medium text-stone-200">
			{navLinks.map((link) => (
				<li>
					<a href={link.href} class="block py-2 transition-colors hover:text-accent">{link.label}</a>
				</li>
			))}
			<li class="pt-2">
				<a
					href="#kom-i-gang"
					class="block rounded-full bg-accent px-5 py-2 text-center font-semibold text-primary"
				>
					Kom i gang
				</a>
			</li>
		</ul>
	</nav>
</header>

<script>
	const toggle = document.getElementById("menu-toggle");
	const menu = document.getElementById("mobile-menu");

	toggle?.addEventListener("click", () => {
		const isOpen = menu?.classList.toggle("hidden") === false;
		toggle.setAttribute("aria-expanded", String(isOpen));
	});

	menu?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => {
			menu.classList.add("hidden");
			toggle?.setAttribute("aria-expanded", "false");
		});
	});
</script>
