---
import { Image } from "astro:assets";
import { site } from "../data/site.js";
import frisorSofie from "../assets/images/case-frisor-sofie.png";

const screenshots: Record<string, ImageMetadata> = {
	"Frisør Sofie": frisorSofie,
};
---

<section id="arbejde" class="bg-navy py-30 md:py-40">
	<div class="mx-auto max-w-6xl px-6">
		<div class="grid gap-8 md:grid-cols-12">
			<div class="md:col-span-7">
				<p class="reveal font-body text-xs font-normal uppercase tracking-[0.2em] text-gold">Arbejde</p>
				<h2 class="reveal mt-4 font-heading text-3xl font-normal text-warm md:text-4xl" style="transition-delay: 100ms;">
					Se, hvad jeg bygger
				</h2>
				<p class="reveal mt-4 max-w-[48ch] text-base font-light leading-relaxed text-mist" style="transition-delay: 150ms;">
					Klik dig rundt og mærk selv hastigheden — det siger mere end en beskrivelse.
				</p>
			</div>
		</div>

		{site.work.map((project) => (
			<article class="reveal mt-16 grid gap-10 md:grid-cols-12 md:items-center md:gap-16">
				<a
					href={project.url}
					target="_blank"
					rel="noopener"
					class="group block overflow-hidden rounded-lg border border-gold/15 md:col-span-7"
				>
					<Image
						src={screenshots[project.name]}
						alt={`Forsiden af ${project.name}`}
						widths={[640, 960, 1440]}
						sizes="(min-width: 768px) 58vw, 100vw"
						class="aspect-video w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.02]"
					/>
				</a>

				<div class="md:col-span-5">
					<p class="text-xs font-normal uppercase tracking-[0.2em] text-gold">{project.label}</p>
					<h3 class="mt-3 font-heading text-2xl font-normal text-warm">{project.name}</h3>
					<p class="mt-4 text-base font-light leading-relaxed text-mist">{project.description}</p>
					<ul class="mt-6 flex flex-col gap-2 text-base font-light text-mist">
						{project.highlights.map((item) => (
							<li class="flex gap-3">
								<span class="mt-[0.7em] h-px w-4 shrink-0 bg-gold" aria-hidden="true"></span>
								{item}
							</li>
						))}
					</ul>
					<a
						href={project.url}
						target="_blank"
						rel="noopener"
						class="btn-arrow group mt-8 inline-flex items-center gap-2 font-normal text-gold"
					>
						<span class="link-underline">Besøg siden</span>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
							<path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
						</svg>
					</a>
				</div>
			</article>
		))}
	</div>
</section>
