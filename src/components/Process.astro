---
import { site } from "../data/site.js";
---

<section id="saadan-arbejder-jeg" class="bg-stone-50 py-20 md:py-28">
	<div class="mx-auto max-w-6xl px-6">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="font-heading text-3xl font-bold text-primary md:text-4xl">Sådan arbejder jeg</h2>
			<p class="mt-4 text-stone-600">Fire trin, ingen overraskelser undervejs.</p>
		</div>

		<div class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
			{site.process.map((item) => (
				<div>
					<span class="font-heading text-3xl font-extrabold text-accent">{item.step}</span>
					<h3 class="mt-3 font-heading text-lg font-semibold text-primary">{item.title}</h3>
					<p class="mt-2 text-stone-600">{item.description}</p>
				</div>
			))}
		</div>
	</div>
</section>
