---
import { site } from "../data/site.js";
---

<section id="saadan-arbejder-jeg" class="bg-stone-50 py-20 md:py-28">
	<div class="mx-auto max-w-6xl px-6">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="font-heading text-3xl font-bold text-primary md:text-4xl">Sådan arbejder jeg</h2>
			<p class="mt-4 text-stone-600">Fire trin, ingen overraskelser undervejs.</p>
		</div>

		<div class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
			{site.process.map((item, i) => (
				<div class="reveal group relative">
					{i !== site.process.length - 1 && (
						<div class="absolute left-6 top-6 hidden h-0.5 w-full bg-stone-200 lg:block" aria-hidden="true"></div>
					)}
					<div class="relative z-10 flex h-12 w-12 items-center justify-center rounded-full bg-primary font-heading text-lg font-bold text-accent transition-transform duration-300 group-hover:scale-110">
						{item.step}
					</div>
					<h3 class="mt-5 font-heading text-lg font-semibold text-primary">{item.title}</h3>
					<p class="mt-2 text-stone-600">{item.description}</p>
				</div>
			))}
		</div>
	</div>
</section>
