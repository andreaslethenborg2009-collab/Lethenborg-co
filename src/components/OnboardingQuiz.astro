---
import { site } from "../data/site.js";

const totalSteps = site.quiz.length + 1;
---

<section id="kom-i-gang" class="bg-primary py-20 md:py-28">
	<div class="mx-auto max-w-2xl px-6">
		<div class="text-center">
			<h2 class="font-heading text-3xl font-bold text-white md:text-4xl">Lad os komme i gang</h2>
			<p class="mt-4 text-stone-300">
				Svar på et par korte spørgsmål — tager 2-3 minutter. Ingen pris kræves for at svare, du
				hører fra mig personligt bagefter.
			</p>
		</div>

		<div class="mt-10 rounded-3xl bg-white p-8 shadow-xl md:p-10">
			<div
				id="quiz-progress"
				class="flex gap-1.5"
				role="progressbar"
				aria-valuemin="1"
				aria-valuemax={totalSteps}
				aria-valuenow="1"
				aria-label={`Spørgsmål 1 af ${totalSteps}`}
			>
				{Array.from({ length: totalSteps }).map((_, i) => (
					<div class="h-1.5 flex-1 rounded-full bg-stone-200 transition-colors duration-300" data-segment={i}></div>
				))}
			</div>

			<form
				id="quiz-form"
				action="https://api.web3forms.com/submit"
				method="POST"
				class="mt-4"
			>
				<input type="hidden" name="access_key" value="1607bfef-f30e-4b1f-81a2-8032198b555d" />
				<input type="hidden" name="subject" value={`Ny henvendelse via ${site.business.name}`} />
				<input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

				{site.quiz.map((q, i) => (
					<div class="quiz-step" data-step={i}>
						<h3 class="font-heading text-xl font-semibold text-primary">{q.question}</h3>

						{q.type === "text" && (
							<input
								type="text"
								name={q.id}
								placeholder={q.placeholder}
								required
								class="mt-6 w-full rounded-xl border border-stone-200 px-4 py-3 focus:border-accent focus:outline-none"
							/>
						)}

						{q.type === "radio" && (
							<div class="mt-6 space-y-3">
								{q.options.map((option) => (
									<label class="group flex cursor-pointer items-center gap-3 rounded-xl border border-stone-200 p-4 transition-colors has-[:checked]:border-accent has-[:checked]:bg-accent/5">
										<input type="radio" name={q.id} value={option} required class="sr-only" />
										<span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-stone-300 transition-colors group-has-[:checked]:border-accent group-has-[:checked]:bg-accent group-has-[:focus-visible]:ring-2 group-has-[:focus-visible]:ring-accent group-has-[:focus-visible]:ring-offset-2">
											<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3 scale-50 opacity-0 transition-all group-has-[:checked]:scale-100 group-has-[:checked]:opacity-100">
												<path d="M20 6 9 17l-5-5" />
											</svg>
										</span>
										<span class="text-stone-700">{option}</span>
									</label>
								))}
							</div>
						)}
					</div>
				))}

				<div class="quiz-step" data-step={site.quiz.length}>
					<h3 class="font-heading text-xl font-semibold text-primary">Hvor skal jeg sende svaret til?</h3>
					<div class="mt-6 space-y-4">
						<input
							type="text"
							name="name"
							placeholder="Dit navn"
							required
							class="w-full rounded-xl border border-stone-200 px-4 py-3 focus:border-accent focus:outline-none"
						/>
						<input
							type="email"
							name="email"
							placeholder="Din email"
							required
							class="w-full rounded-xl border border-stone-200 px-4 py-3 focus:border-accent focus:outline-none"
						/>
						<input
							type="tel"
							name="phone"
							placeholder="Telefonnummer (valgfrit)"
							class="w-full rounded-xl border border-stone-200 px-4 py-3 focus:border-accent focus:outline-none"
						/>
					</div>
				</div>

				<div class="mt-8 flex items-center justify-between gap-4">
					<button
						id="quiz-back"
						type="button"
						class="hidden font-medium text-stone-500 transition-colors hover:text-primary"
					>
						Tilbage
					</button>
					<div class="ml-auto flex gap-3">
						<button
							id="quiz-next"
							type="button"
							class="rounded-full bg-primary px-6 py-3 font-semibold text-white transition-colors hover:bg-primary-light"
						>
							Næste
						</button>
						<button
							id="quiz-submit"
							type="submit"
							class="hidden rounded-full bg-accent px-6 py-3 font-semibold text-primary transition-colors hover:bg-accent/90"
						>
							Send
						</button>
					</div>
				</div>
			</form>

			<div id="quiz-success" class="hidden text-center">
				<h3 class="font-heading text-xl font-semibold text-primary">Tak for dine svar!</h3>
				<p class="mt-3 text-stone-600">
					Jeg vender tilbage til dig personligt med et forslag og en pris hurtigst muligt.
				</p>
			</div>

			<p id="quiz-error" class="mt-4 hidden text-sm text-red-600">
				Der gik noget galt med afsendelsen. Prøv igen, eller ring på {site.business.phone}.
			</p>
		</div>
	</div>
</section>

<script>
	const form = document.getElementById("quiz-form") as HTMLFormElement;
	const steps = Array.from(form.querySelectorAll<HTMLDivElement>(".quiz-step"));
	const backBtn = document.getElementById("quiz-back") as HTMLButtonElement;
	const nextBtn = document.getElementById("quiz-next") as HTMLButtonElement;
	const submitBtn = document.getElementById("quiz-submit") as HTMLButtonElement;
	const progress = document.getElementById("quiz-progress") as HTMLDivElement;
	const segments = Array.from(progress.querySelectorAll<HTMLDivElement>("[data-segment]"));
	const successEl = document.getElementById("quiz-success") as HTMLDivElement;
	const errorEl = document.getElementById("quiz-error") as HTMLParagraphElement;

	let current = 0;

	function render() {
		steps.forEach((step, i) => step.classList.toggle("hidden", i !== current));
		backBtn.classList.toggle("hidden", current === 0);
		nextBtn.classList.toggle("hidden", current === steps.length - 1);
		submitBtn.classList.toggle("hidden", current !== steps.length - 1);

		segments.forEach((segment, i) => {
			segment.classList.toggle("bg-accent", i <= current);
			segment.classList.toggle("bg-stone-200", i > current);
		});
		progress.setAttribute("aria-valuenow", String(current + 1));
		progress.setAttribute("aria-label", `Spørgsmål ${current + 1} af ${steps.length}`);
	}

	function currentStepValid() {
		const inputs = steps[current].querySelectorAll<HTMLInputElement>("input");
		for (const input of inputs) {
			if (!input.reportValidity()) return false;
		}
		return true;
	}

	nextBtn.addEventListener("click", () => {
		if (!currentStepValid()) return;
		current++;
		render();
	});

	backBtn.addEventListener("click", () => {
		current--;
		render();
	});

	form.addEventListener("submit", async (e) => {
		e.preventDefault();
		if (!currentStepValid()) return;

		submitBtn.disabled = true;
		submitBtn.textContent = "Sender...";
		errorEl.classList.add("hidden");

		try {
			const res = await fetch(form.action, {
				method: "POST",
				headers: { Accept: "application/json" },
				body: new FormData(form),
			});
			const data = await res.json();
			if (data.success) {
				form.classList.add("hidden");
				successEl.classList.remove("hidden");
			} else {
				throw new Error(data.message ?? "Unknown error");
			}
		} catch {
			submitBtn.disabled = false;
			submitBtn.textContent = "Send";
			errorEl.classList.remove("hidden");
		}
	});

	render();
</script>
