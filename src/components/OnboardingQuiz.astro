---
import { site } from "../data/site.js";

const totalSteps = site.quiz.length + 1;
---

<section id="kom-i-gang" class="bg-warm py-30 md:py-40">
	<div class="mx-auto max-w-6xl px-6">
		<div class="grid gap-16 md:grid-cols-12 md:gap-16">
			<div class="reveal md:col-span-5">
				<h2 class="font-heading text-3xl font-normal text-navy md:text-4xl">Lad os komme i gang</h2>
				<p class="mt-4 max-w-[42ch] text-base font-light leading-relaxed text-navy/70">
					Svar på et par korte spørgsmål — tager 2-3 minutter. Ingen pris kræves for at svare, du
					hører fra mig personligt bagefter.
				</p>
				<div class="mt-10 flex flex-col gap-2 text-base font-light text-navy/70">
					<a href={`tel:${site.business.phone.replace(/\s/g, "")}`} class="link-underline w-fit hover:text-gold">
						{site.business.phone}
					</a>
					<a href={`mailto:${site.business.email}`} class="link-underline w-fit hover:text-gold">
						{site.business.email}
					</a>
					<p>{site.business.area}</p>
				</div>
			</div>

			<div class="md:col-span-7">
				<div
					id="quiz-progress"
					class="flex gap-1.5"
					role="progressbar"
					aria-valuemin="1"
					aria-valuemax={totalSteps}
					aria-valuenow="1"
					aria-label={`Spørgsmål 1 af ${totalSteps}`}
				>
					{Array.from({ length: totalSteps }).map((_, i) => (
						<div class="h-px flex-1 bg-navy/10 transition-colors duration-300" data-segment={i}></div>
					))}
				</div>

				<form
					id="quiz-form"
					action="https://api.web3forms.com/submit"
					method="POST"
					class="mt-10"
				>
					<input type="hidden" name="access_key" value="1607bfef-f30e-4b1f-81a2-8032198b555d" />
					<input type="hidden" name="subject" value={`Ny henvendelse via ${site.business.name}`} />
					<input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

					{site.quiz.map((q, i) => (
						<div class="quiz-step" data-step={i}>
							<h3 class="font-heading text-xl font-normal text-navy">{q.question}</h3>

							{q.type === "text" && (
								<input
									type="text"
									name={q.id}
									placeholder={q.placeholder}
									required
									class="mt-6 w-full border-b border-navy/20 bg-transparent px-1 py-3 text-navy placeholder:text-navy/40 transition-colors focus:border-gold focus:outline-none"
								/>
							)}

							{q.type === "radio" && (
								<div class="mt-6">
									{q.options.map((option) => (
										<label class="group flex cursor-pointer items-center justify-between gap-3 border-b border-navy/10 py-4 transition-colors has-[:checked]:border-gold">
											<span class="font-light text-navy/70 transition-colors group-has-[:checked]:font-normal group-has-[:checked]:text-navy">
												{option}
											</span>
											<span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-navy/30 transition-colors group-has-[:checked]:border-gold group-has-[:checked]:bg-gold group-has-[:focus-visible]:ring-2 group-has-[:focus-visible]:ring-gold group-has-[:focus-visible]:ring-offset-2">
											</span>
											<input type="radio" name={q.id} value={option} required class="sr-only" />
										</label>
									))}
								</div>
							)}
						</div>
					))}

					<div class="quiz-step" data-step={site.quiz.length}>
						<h3 class="font-heading text-xl font-normal text-navy">Hvor skal jeg sende svaret til?</h3>
						<div class="mt-6 flex flex-col gap-2">
							<input
								type="text"
								name="name"
								placeholder="Dit navn"
								required
								class="w-full border-b border-navy/20 bg-transparent px-1 py-3 text-navy placeholder:text-navy/40 transition-colors focus:border-gold focus:outline-none"
							/>
							<input
								type="email"
								name="email"
								placeholder="Din email"
								required
								class="w-full border-b border-navy/20 bg-transparent px-1 py-3 text-navy placeholder:text-navy/40 transition-colors focus:border-gold focus:outline-none"
							/>
							<input
								type="tel"
								name="phone"
								placeholder="Telefonnummer (valgfrit)"
								class="w-full border-b border-navy/20 bg-transparent px-1 py-3 text-navy placeholder:text-navy/40 transition-colors focus:border-gold focus:outline-none"
							/>
						</div>
					</div>

					<div class="mt-10 flex items-center justify-between gap-4">
						<button
							id="quiz-back"
							type="button"
							class="hidden font-light text-navy/50 transition-colors hover:text-navy"
						>
							Tilbage
						</button>
						<div class="ml-auto flex gap-3">
							<button
								id="quiz-next"
								type="button"
								class="btn-arrow group inline-flex items-center gap-2 rounded-full border border-gold px-6 py-3 font-normal text-gold transition-colors hover:bg-gold hover:text-navy"
							>
								Næste
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
									<path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
								</svg>
							</button>
							<button
								id="quiz-submit"
								type="submit"
								class="hidden rounded-full bg-gold px-6 py-3 font-normal uppercase tracking-wide text-navy transition-colors hover:bg-gold/90"
							>
								Send
							</button>
						</div>
					</div>
				</form>

				<div id="quiz-success" class="hidden">
					<h3 class="font-heading text-xl font-normal text-navy">Tak — jeg vender tilbage inden for 24 timer.</h3>
				</div>

				<p id="quiz-error" class="mt-4 hidden text-sm text-red-600">
					Der gik noget galt med afsendelsen. Prøv igen, eller ring på {site.business.phone}.
				</p>
			</div>
		</div>
	</div>
</section>

<script>
	const form = document.getElementById("quiz-form") as HTMLFormElement;
	const steps = Array.from(form.querySelectorAll<HTMLDivElement>(".quiz-step"));
	const backBtn = document.getElementById("quiz-back") as HTMLButtonElement;
	const nextBtn = document.getElementById("quiz-next") as HTMLButtonElement;
	const submitBtn = document.getElementById("quiz-submit") as HTMLButtonElement;
	const progress = document.getElementById("quiz-progress") as HTMLDivElement;
	const segments = Array.from(progress.querySelectorAll<HTMLDivElement>("[data-segment]"));
	const successEl = document.getElementById("quiz-success") as HTMLDivElement;
	const errorEl = document.getElementById("quiz-error") as HTMLParagraphElement;

	let current = 0;

	function render() {
		steps.forEach((step, i) => step.classList.toggle("hidden", i !== current));
		backBtn.classList.toggle("hidden", current === 0);
		nextBtn.classList.toggle("hidden", current === steps.length - 1);
		submitBtn.classList.toggle("hidden", current !== steps.length - 1);

		segments.forEach((segment, i) => {
			segment.classList.toggle("bg-gold", i <= current);
			segment.classList.toggle("bg-navy/10", i > current);
		});
		progress.setAttribute("aria-valuenow", String(current + 1));
		progress.setAttribute("aria-label", `Spørgsmål ${current + 1} af ${steps.length}`);
	}

	function currentStepValid() {
		const inputs = steps[current].querySelectorAll<HTMLInputElement>("input");
		for (const input of inputs) {
			if (!input.reportValidity()) return false;
		}
		return true;
	}

	nextBtn.addEventListener("click", () => {
		if (!currentStepValid()) return;
		current++;
		render();
	});

	backBtn.addEventListener("click", () => {
		current--;
		render();
	});

	form.addEventListener("submit", async (e) => {
		e.preventDefault();
		if (!currentStepValid()) return;

		submitBtn.disabled = true;
		submitBtn.textContent = "Sender...";
		errorEl.classList.add("hidden");

		try {
			const res = await fetch(form.action, {
				method: "POST",
				headers: { Accept: "application/json" },
				body: new FormData(form),
			});
			const data = await res.json();
			if (data.success) {
				form.classList.add("hidden");
				progress.classList.add("hidden");
				successEl.classList.remove("hidden");
			} else {
				throw new Error(data.message ?? "Unknown error");
			}
		} catch {
			submitBtn.disabled = false;
			submitBtn.textContent = "Send";
			errorEl.classList.remove("hidden");
		}
	});

	render();
</script>
